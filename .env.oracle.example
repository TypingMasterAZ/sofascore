NODE_ENV=production
PORT=3000

# Replace this with your HTTPS domain after the Oracle VM is ready.
# Example with your own domain: https://live.example.com
# Test-only example with IP DNS: https://YOUR_PUBLIC_IP.sslip.io
PUBLIC_URL=https://YOUR_DOMAIN

# Oracle VPS does not sleep, so Render-style self-ping is not needed.
KEEPALIVE_ENABLED=false
LIVE_SCORE_POLL_INTERVAL_MS=2500
RUNTIME_WARMUP_INTERVAL_MS=60000
CATEGORY_WARMUP_INTERVAL_MS=180000
LIVE_PRIMARY_SOURCE=mackolik
ENABLE_MACKOLIK_MATCHES=true
ALLOW_MACKOLIK_FALLBACK=true

# Web Push. Leave public/private empty to use the bundled pair from server.js,
# or set your own pair if you generate one with the web-push package.
WEB_PUSH_SUBJECT=mailto:support@your-domain.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Firebase Admin is optional for FCM, but Web Push works without it.
# Paste the whole service account JSON in one line if you use Firebase Admin.
FIREBASE_SERVICE_ACCOUNT=

# Optional email support settings.
EMAIL_USER=
EMAIL_PASS=
SUPPORT_NOTIFY_EMAIL=

# Optional SofaScore fallbacks.
RAPIDAPI_KEY=
SOFA_PROXY_URL=
GAS_PROXY_URL=
SOFA_PROXY_URL_2=
GAS_PROXY_URL_2=
